{
  "$schema": "https://unpkg.com/knip@next/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/main.tsx"
  ],
  "project": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx"
  ],
  "ignore": [
    "src/main/collab-server.js"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "electron",
    "electron-builder",
    "electron-vite"
  ]
}
